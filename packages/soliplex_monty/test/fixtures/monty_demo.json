[
  {
    "version": "1.0",
    "createSurface": {
      "surfaceId": "surface_2",
      "catalogId": "https://a2ui.org/specification/v1_0/catalogs/basic/catalog.json"
    }
  },
  {
    "version": "1.0",
    "updateDataModel": {
      "surfaceId": "surface_2",
      "path": "/",
      "value": {
        "source": "__CURATED_SOURCE__",
        "title": "Monty GUI demo",
        "output": ""
      }
    }
  },
  {
    "version": "1.0",
    "updateComponents": {
      "surfaceId": "surface_2",
      "components": [
        {
          "id": "root",
          "component": "PythonRepl",
          "@catalogId": "urn:soliplex:catalog:lab:1",
          "source": {
            "@path": "/source"
          },
          "outputPath": "/output",
          "onWorkbench": {
            "event": {
              "name": "workbench.program.layout",
              "context": {
                "invocationId": {
                  "@path": "/output/invocationId"
                },
                "actions": {
                  "@path": "/output/actions"
                }
              }
            }
          },
          "onRun": {
            "event": {
              "name": "workbench.program.run_result",
              "context": {
                "side": "client",
                "engine": "monty-1.3.0",
                "invocationId": {
                  "@path": "/output/invocationId"
                },
                "chainId": {
                  "@path": "/output/chainId"
                },
                "outcome": {
                  "@path": "/output/outcome"
                },
                "output": {
                  "@path": "/output/output"
                }
              }
            }
          }
        }
      ]
    }
  }
]
