        "window": "Monty GUI demo",
        "awaitTurn": true,
        "assertions": [
          {
            "kind": "text",
            "name": "Count: 3",
            "window": "Monty GUI demo app",
            "initialViewport": true
          },
          {
            "kind": "role",
            "role": "button",
            "name": "Bar Start: 3",
            "window": "Monty GUI demo app",
            "initialViewport": true
          },
          {
            "kind": "role",
            "role": "group",
            "name": "Workbench window Monty event log",
            "absent": true
          }
        ]
      },
      {
        "role": "button",
        "name": "+1",
        "window": "Monty GUI demo app",
        "assertions": [
          {
            "kind": "text",
            "name": "Count: 4",
            "window": "Monty GUI demo app",
            "initialViewport": true
          }
        ],
        "initialViewport": true
      },
      {
        "role": "button",
        "name": "Add point",
