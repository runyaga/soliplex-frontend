# Copy to workbench.env (untracked) and fill in. setup-stack.sh reads it.

# Required. Absolute development root holding the source checkouts and stack trees.
DEV_ROOT="${HOME}/dev"
# Required. Hostname or IP for Glimmer, embeddings and reranking, without scheme or port.
MODEL_HOST="model-host.example.invalid"
# Required. Ollama hostname or IP for Gemma 4 E4B, without scheme or port.
OLLAMA_HOST="ollama-host.example.invalid"
# Required. Operator-chosen Authelia login and display name.
WB_ADMIN_USER="choose-an-admin-login"
# Required. Email for the Authelia user and the Soliplex admin record.
WB_ADMIN_EMAIL="admin-email-for-authelia"
# Required. Choose a password locally. Single quotes preserve literal shell characters.
WB_ADMIN_PASSWORD=''
# Optional. Shell env file containing LOGFIRE_TOKEN. Defaults to $DEV_ROOT/.env.
LOGFIRE_ENV_FILE="${DEV_ROOT}/.env"
# Optional explicit comma-separated room IDs whose AG-UI run submissions use workbench actions.
# Defaults to empty; legacy lab rooms are intentionally not included.
SOLIPLEX_WORKBENCH_ROOMS="workbench,workbench-e4b"
